---
// Layout shell (DESIGN §4): nav + main + footer on every page.
// JS budget (DESIGN §10): one small module (src/scripts/ui.ts — theme toggle
// + mobile hamburger, owner 2026-11-21) plus the pre-paint theme snippet
// below. No islands, no frameworks, no hydration.
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { site } from '../lib/data';

interface Props {
  title: string;
  description?: string;
  // 404: not indexable — no canonical link, robots noindex.
  noindex?: boolean;
}

const { title, description = site.description, noindex = false } = Astro.props;
const canonical = noindex ? null : new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      // Theme (DESIGN §8): restore the saved choice (auto|light|dark) before
      // first paint so there is no flash of the wrong scheme. data-choice
      // drives the nav icon; data-theme drives the colors (absent in auto —
      // the OS preference decides, no JS needed). Companion to ui.ts.
      try {
        var t = localStorage.getItem('theme');
        t = t === 'light' || t === 'dark' || t === 'auto' ? t : 'auto';
        document.documentElement.dataset.choice = t;
        if (t !== 'auto') document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
    <meta name="color-scheme" content="light dark" />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Dark-tab twin: bare monogram in the dark theme accent (favicons can't
         read the page's JS theme, so this follows the browser/OS scheme). -->
    <link rel="icon" type="image/svg+xml" href="/favicon-dark.svg" media="(prefers-color-scheme: dark)" />
    <link rel="manifest" href="/manifest.json" />
    {canonical && <link rel="canonical" href={canonical} />}
    <slot name="head" />
  </head>
  <body>
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
    <script src="../scripts/ui.ts"></script>
  </body>
</html>
