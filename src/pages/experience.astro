---
// Experience (DESIGN §7): vertical timeline (owner 2026-11-22) — dates +
// location + company logo on the left, an open circle on a 1 px rail,
// role-only title + bullets on the right (the organization leads the first
// bullet, owner 2026-11-22 — titles stay on one line). No page lead.
// Data from content/experience.yaml (newest first).
import Layout from '../layouts/Layout.astro';
import Link from '../components/Link.astro';
import { experience, site, navLabelFor } from '../lib/data';

const extraLinks = (links: { label: string; href: string }[] | undefined) =>
  (links ?? []).slice(1);
---
<Layout title={`${navLabelFor('/experience')} — ${site.title}`}>
  <div class="container page-top">
    <header class="page-header">
      <h1>{navLabelFor('/experience')}</h1>
    </header>
    <ul class="rows xp">
      {
        experience.entries.map((entry) => (
          <li class="row">
            <div class="xp-left">
              <span class="xp-dates">
                {entry.dates}
                {entry.location && <span class="xp-loc">{entry.location}</span>}
              </span>
              {entry.logoAsset && (
                <span class="xp-logo">
                  <img
                    src={entry.logoAsset.src}
                    width={entry.logoAsset.width}
                    height={entry.logoAsset.height}
                    alt=""
                    aria-hidden="true"
                  />
                </span>
              )}
            </div>
            <span class="xp-node" aria-hidden="true"></span>
            <div class="xp-main">
              <p class="row-title">
                {entry.role}
                {entry.company && ` · ${entry.company}`}
                {
                  extraLinks(entry.links).map((link) => (
                    <span class="row-alt-links">
                      {' · '}
                      <Link href={link.href} label={link.label} />
                    </span>
                  ))
                }
              </p>
              {
                entry.bullets && (
                  <ul class="row-bullets">
                    {entry.bullets.map((bullet) => (
                      <li>{bullet}</li>
                    ))}
                  </ul>
                )
              }
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</Layout>
