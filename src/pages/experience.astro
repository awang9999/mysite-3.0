---
// Experience (DESIGN §7): one hairline row per role — "Role · Company"
// title line, date range + location meta line, 1–3 concrete bullets.
// No timeline rail. Data from content/experience.yaml (newest first).
import Layout from '../layouts/Layout.astro';
import Link from '../components/Link.astro';
import { experience, site, navLabelFor } from '../lib/data';

const extraLinks = (links: { label: string; href: string }[] | undefined) =>
  (links ?? []).slice(1);
---
<Layout title={`${navLabelFor('/experience')} — ${site.title}`}>
  <div class="container page-top">
    <header class="page-header">
      <h1>{navLabelFor('/experience')}</h1>
      {experience.lead && <p class="lead">{experience.lead}</p>}
    </header>
    <ul class="rows">
      {
        experience.entries.map((entry) => (
          <li class="row">
            <p class="row-title">
              {entry.role}
              {entry.company && ` · ${entry.company}`}
              {
                extraLinks(entry.links).map((link) => (
                  <span class="row-alt-links">
                    {' · '}
                    <Link href={link.href} label={link.label} />
                  </span>
                ))
              }
            </p>
            <p class="row-meta">
              {[entry.dates, entry.location].filter(Boolean).join(' · ')}
            </p>
            {
              entry.bullets && (
                <ul class="row-bullets">
                  {entry.bullets.map((bullet) => (
                    <li>{bullet}</li>
                  ))}
                </ul>
              )
            }
          </li>
        ))
      }
    </ul>
  </div>
</Layout>
