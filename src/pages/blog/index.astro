---
// Blog index (DESIGN §7): one hairline row per post — meta line
// (date · reading time), title (accent link), one-line excerpt. Newest
// first. The display order
// comes from content/blog/index.yaml, the source of truth for /blog.
import Layout from '../../layouts/Layout.astro';
import { blogIndex, site, navLabelFor } from '../../lib/data';
import { formatDate } from '../../lib/format';
---
<Layout title={`${navLabelFor('/blog')} — ${site.title}`}>
  <div class="container page-top">
    <header class="page-header">
      <h1>{navLabelFor('/blog')}</h1>
      {blogIndex.lead && <p class="lead">{blogIndex.lead}</p>}
    </header>
    <ul class="rows">
      {
        blogIndex.posts.map((post) => (
          <li class="row">
            <p class="row-meta">{formatDate(post.date)} · {post.readingTime} min read</p>
            <p class="row-title">
              <a href={`/blog/${post.slug}`}>{post.title}</a>
            </p>
            <p class="row-body">{post.summary}</p>
          </li>
        ))
      }
    </ul>
  </div>
</Layout>
