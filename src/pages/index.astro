---
// Home — hero (DESIGN §4): fills the viewport under the nav and centers
// the profile + text vertically; the footer sits below the fold and only
// appears on scroll (owner, 2026-11-22). Name as h1, muted role line,
// owner-approved link set (Résumé · GitHub · Blog, DESIGN §11). All copy
// from content/home.md.
// Below the hero: the About section (owner, 2026-11-22 — /about retired,
// the nav's "About" links here at #about). Verbatim 2.0 "About Me" copy
// the hero doesn't cover + the contact emails.
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Link from '../components/Link.astro';
import { site } from '../lib/data';
import portrait from '../assets/portrait.jpg';

const [home] = await getCollection('sitePages', (entry) => entry.id === 'home');
const { name, role, bio, links, about } = home.data;
---
<Layout title={site.title} description={site.description}>
  <section class="container hero">
    <div class="hero-inner">
      <img class="hero-portrait" src={portrait.src} width="440" height="440" alt="Portrait of Alexander Wang" />
      <div class="hero-copy">
        <h1>{name}</h1>
        <p class="hero-role">{role}</p>
        {bio && <p class="hero-bio">{bio}</p>}
        <p class="hero-links">
          {
            (links ?? []).map((link) => (
              <Link href={link.href} label={link.label} newTab={link.newTab} />
            ))
          }
        </p>
      </div>
    </div>
  </section>

  <!-- About (owner, 2026-11-22): /about retired — the About Me content the
       hero doesn't already carry lives here, below the fold. "About" in
       the nav is the only path to it (/#about). -->
  {
    about && (
      <section class="home-about" id="about">
        <div class="container">
          <h2>About</h2>
          {
            (about.paragraphs ?? []).map((paragraph) => (
              <p>{paragraph}</p>
            ))
          }
          <p>
            Contact me at:
            {
              (about.emails ?? []).map((email, i) => (
                <Fragment>
                  {i > 0 && ' or '}
                  <a href={`mailto:${email}`}>{email}</a>
                </Fragment>
              ))
            }.
          </p>
        </div>
      </section>
    )
  }
</Layout>
