---
// Projects (DESIGN §6) — the signature page. One language: rows.
// Featured set (owner-approved, content/projects.yaml) + native <details>
// archive with the year in the meta line. Zero JS.
// Row link rule: the first link rides the row title; any further links sit
// beside it separated by " · " (DESIGN is silent on multi-link rows).
import Layout from '../layouts/Layout.astro';
import Link from '../components/Link.astro';
import { projects, site, navLabelFor } from '../lib/data';

const altLinks = (links: { label: string; href: string }[] | undefined) =>
  (links ?? []).slice(1);
---
<Layout title={`${navLabelFor('/projects')} — ${site.title}`}>
  <div class="container container--wide page-top">
    <header class="page-header">
      <h1>{navLabelFor('/projects')}</h1>
      {projects.lead && <p class="lead">{projects.lead}</p>}
    </header>

    <ul class="rows">
      {
        projects.featured.map((project) => (
          <li class="row">
            <p class="row-title">
              {project.links?.[0] ? (
                <Link href={project.links[0].href} label={project.name} />
              ) : (
                project.name
              )}
              {
                altLinks(project.links).map((link) => (
                  <span class="row-alt-links">
                    {' · '}
                    <Link href={link.href} label={link.label} />
                  </span>
                ))
              }
            </p>
            <p class="row-body">{project.hook}</p>
            {project.body && <p class="row-body">{project.body}</p>}
            {
              project.tags && project.tags.length > 0 && (
                <p class="row-tags">{project.tags.join(' · ')}</p>
              )
            }
          </li>
        ))
      }
    </ul>

    <details class="archive">
      <summary>
        <svg class="chev" viewBox="0 0 10 10" width="10" height="10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3.5 1.5L7 5L3.5 8.5" />
        </svg>
        Show all {projects.archive.length} projects
      </summary>
      <ul class="rows">
        {
          projects.archive.map((project) => (
            <li class="row">
              <p class="row-title">
                {project.links?.[0] ? (
                  <Link href={project.links[0].href} label={project.name} />
                ) : (
                  project.name
                )}
                {
                  altLinks(project.links).map((link) => (
                    <span class="row-alt-links">
                      {' · '}
                      <Link href={link.href} label={link.label} />
                    </span>
                  ))
                }
              </p>
              <p class="row-body">{project.line}</p>
              <p class="row-meta">{project.year}</p>
            </li>
          ))
        }
      </ul>
    </details>
  </div>
</Layout>
