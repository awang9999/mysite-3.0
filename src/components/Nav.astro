---
// Nav (DESIGN §4): static, hairline bottom border, content-width container.
// Left: text wordmark. Right: About · Experience · Projects · Blog · Résumé.
// Current page → --accent/500. Mobile: wraps to two centered lines, no
// hamburger. Data comes from content/site.yaml — no copy hardcoded here.
import { site } from '../lib/data';

// The 2.0 AW monogram is inlined in the template below (not <img>) so
// fill="currentColor" inherits the page's --accent and adapts to light/dark.
// (An SVG inside <img> renders in its own document, where currentColor is
// always the SVG default black — which made the mark invisible on dark.)
// Source of the mark: src/assets/monogram.svg (also feeds the favicon).

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---
<header class="nav">
  <div class="container nav-inner">
    <a class="wordmark" href="/">
      <svg class="wordmark-mark" width="24" height="24" viewBox="0 0 64 64" aria-hidden="true" fill="currentColor">
        <path d="M31.205 2.352h2.517l12.587 30.293h-3.157l-4.608-11.819H26.256l-4.523 11.819h-3.2zm7.339 18.475L32.442 5.851l-6.187 14.976zM30.203 44.02l1.895-4.645 1.774 4.645h0l5.803 13.696L50.64 30.878h3.243L41.04 61.172h-2.645l-6.357-14.976-6.4 14.976h-2.603l-12.8-30.293h3.2l11.008 26.837z" />
      </svg>
      {site.title}
    </a>
    <nav class="nav-links" aria-label="Main">
      {
        site.nav.map((item) => (
          <a href={item.href} {...isActive(item.href) ? { 'aria-current': 'page' } : {}}>{item.label}</a>
        ))
      }
    </nav>
  </div>
</header>
