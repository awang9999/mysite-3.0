---
// Nav (DESIGN §4): static, hairline bottom border, content-width container.
// Left: monogram + text wordmark. Right: links + theme toggle.
// Mobile (≤ 640 px): wordmark + toggle + hamburger; the links open as a
// centered panel (owner, 2026-11-21) — open/close logic in src/scripts/ui.ts.
// Current page → --accent/500. Data comes from content/site.yaml — no copy
// hardcoded here.
//
// The monogram is inlined (not <img>) so fill="currentColor" inherits the
// page's --accent and adapts to light/dark — an SVG inside <img> renders in
// its own document, where currentColor is always the SVG default black (it
// made the mark invisible on the dark theme). Source of the mark:
// src/assets/monogram.svg (also feeds the favicon).
import { site } from '../lib/data';

const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(`${href}/`);
---
<header class="nav">
  <div class="container nav-inner">
    <a class="wordmark" href="/">
      <svg class="wordmark-mark" width="24" height="24" viewBox="0 0 64 64" aria-hidden="true" fill="currentColor">
        <path d="M31.205 2.352h2.517l12.587 30.293h-3.157l-4.608-11.819H26.256l-4.523 11.819h-3.2zm7.339 18.475L32.442 5.851l-6.187 14.976zM30.203 44.02l1.895-4.645 1.774 4.645h0l5.803 13.696L50.64 30.878h3.243L41.04 61.172h-2.645l-6.357-14.976-6.4 14.976h-2.603l-12.8-30.293h3.2l11.008 26.837z" />
      </svg>
      <span>{site.title}</span>
    </a>
    <nav class="nav-links" id="nav-links" aria-label="Main">
      {
        site.nav.map((item) => (
          <a
            href={item.href}
            {...item.newTab ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
            {...isActive(item.href) ? { 'aria-current': 'page' } : {}}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <!-- Theme picker (owner, 2026-11-22): dropdown — Automatic / Light / Dark.
         The button icon mirrors the saved choice (CSS reads data-choice from
         <html>, set pre-paint by the <head> snippet); menu logic is in ui.ts. -->
    <div class="theme-picker">
      <button class="icon-btn theme-toggle" type="button" aria-label="Theme: automatic" aria-haspopup="menu" aria-expanded="false" aria-controls="theme-menu">
        <svg class="icon-auto" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="8" />
          <path d="M12 4a8 8 0 0 1 0 16z" fill="currentColor" stroke="none" />
        </svg>
        <svg class="icon-sun" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
        </svg>
        <svg class="icon-moon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
        </svg>
      </button>
      <div class="theme-menu" id="theme-menu" role="menu" aria-label="Theme">
        <button type="button" role="menuitemradio" aria-checked="true" data-value="auto">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="8" />
            <path d="M12 4a8 8 0 0 1 0 16z" fill="currentColor" stroke="none" />
          </svg>
          Automatic
          <svg class="icon-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12l5 5L20 7" />
          </svg>
        </button>
        <button type="button" role="menuitemradio" aria-checked="false" data-value="light">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" />
          </svg>
          Light
          <svg class="icon-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12l5 5L20 7" />
          </svg>
        </button>
        <button type="button" role="menuitemradio" aria-checked="false" data-value="dark">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
          </svg>
          Dark
          <svg class="icon-check" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12l5 5L20 7" />
          </svg>
        </button>
      </div>
    </div>
    <!-- Hamburger: mobile only, opens #nav-links (see ui.ts). -->
    <button class="icon-btn nav-burger" type="button" aria-label="Menu" aria-controls="nav-links" aria-expanded="false">
      <svg class="icon-burger" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16" />
      </svg>
      <svg class="icon-close" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>
  </div>
</header>
